# Private model gateway credentials for local benchmark-agent runs.
# Copy this file to .env and fill OPENAI_API_KEY locally. Do not commit .env.
OPENAI_API_KEY="replace-with-your-key"
OPENAI_BASE_URL="https://codex-byering.com:8317/v1"
MODEL="gpt-5.6"

# Optional per-agent overrides. When omitted, the loader uses MODEL.
# OPENHANDS_MODEL="gpt-5.2"
# SWE_AGENT_MODEL="gpt-5.2"
