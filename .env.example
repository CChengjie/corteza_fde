# Local runtime
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
AUTH_BASE_URL=http://localhost:8080
BUILD_VERSION=city311-development
ENVIRONMENT=production
HTTP_API_BASE_URL=/api
PROVISION_ALWAYS=true
PROVISION_PATH=/corteza/provision/*
BENCHMARK_TIMEZONE=America/New_York
BENCHMARK_NOW=2099-01-01T00:00:00Z
BENCHMARK_SEED=city311-public-v1

# PostgreSQL. When changing these values, set DATABASE_URL to match them.
POSTGRES_DB=corteza
POSTGRES_USER=corteza
POSTGRES_PASSWORD=corteza-local-password
DATABASE_URL=postgres://corteza:corteza-local-password@postgres:5432/corteza?sslmode=disable

# Replace every secret before using this deployment outside a local workstation.
AUTH_JWT_SECRET=local-only-jwt-secret-change-before-deployment
AUTH_EXTERNAL_COOKIE_SECRET=local-only-cookie-secret-change-before-deployment
AUTH_CSRF_SECRET=local-only-csrf-secret-change-before-deployment
SESSION_SECRET=local-only-city311-session-secret-change-before-deployment
CITY311_SEED_CONSTITUENT_PASSWORD=City311-Local-Constituent-1!
CITY311_SEED_CONSTITUENT_TWO_PASSWORD=City311-Local-Constituent-2!
CITY311_SEED_STAFF_PASSWORD=City311-Local-Staff-1!
CITY311_SEED_ADMIN_PASSWORD=City311-Local-Admin-1!

# Required City 311 integrations. All local services use deterministic
# fixtures bundled in the standard Compose environment.
MAP_BASE_URL=http://integration-fixture:8080
MAP_API_TOKEN=local-only-mapping-token
CIVICWORKS_FIXTURE_PORT=8081
CIVICWORKS_BASE_URL=http://civicworks:8080
CIVICWORKS_CALLBACK_BASE_URL=http://app:80
CIVICWORKS_API_TOKEN=local-only-civicworks-token
CIVICWORKS_CONTROL_TOKEN=local-only-civicworks-control-token
CIVICWORKS_WEBHOOK_SECRET=local-only-civicworks-webhook-secret
BENCHMARK_RUN_ID=city311-local
WORKFLOW_OAUTH_TOKEN_URL=http://integration-fixture:8080/oauth/token
WORKFLOW_API_BASE_URL=http://integration-fixture:8080
WORKFLOW_CLIENT_ID=city311-local
WORKFLOW_CLIENT_SECRET=local-only-workflow-secret
OIDC_ISSUER_URL=http://integration-fixture:8080
OIDC_STAFF_CLIENT_ID=city311-staff
OIDC_PUBLIC_CLIENT_ID=city311-public
OIDC_CLIENT_SECRET=local-only-oidc-secret
SAML_METADATA_URL=http://integration-fixture:8080/saml/metadata
SAML_SP_ENTITY_ID=http://localhost:8080/saml
CRM_API_CLIENT_ID=city311-local-api-client
CRM_API_CLIENT_SECRET=local-only-crm-api-secret

# Required mail fixture and SMTP delivery settings. The Compose runtime maps
# these values to Corteza's SMTP_* settings for account-security messages too.
MAIL_SMTP_HOST=integration-fixture
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=city311-local
MAIL_SMTP_PASSWORD=local-only-mail-password
MAIL_API_BASE_URL=http://integration-fixture:8080
MAIL_API_TOKEN=local-only-mail-api-token
MAIL_FROM=noreply@city.example
